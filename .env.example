# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already covered by .gitignore.

# MongoDB Atlas (or any reachable MongoDB) connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Flask session secret key — any random long string
SECRET_KEY=<a-long-random-secret-string>
